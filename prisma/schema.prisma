// Prisma schema — Phase 1 foundation.
// Unifies the old two disconnected Mongo collections (Teacher directory record
// vs TeacherNotice login+notices record) into one relational model: `User` is
// the Auth.js identity, `Teacher`/`Student` are 1:1 profile extensions of it.

generator client {
  provider = "prisma-client-js"
}

// The connection URL itself now lives in prisma.config.mjs (for the CLI) and
// lib/prisma.js (for the app, via a driver adapter) — Prisma 7 removed
// `url` from the datasource block.
datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  name         String
  image        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teacher       Teacher?
  student       Student?
  noticesPosted Notice[]

  @@map("users")
}

model Department {
  id       String    @id @default(cuid())
  name     String    @unique
  teachers Teacher[]
  students Student[]
  subjects Subject[]

  @@map("departments")
}

model Teacher {
  id           String      @id @default(cuid())
  userId       String      @unique
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone        String?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  periods      Period[]
  attendanceSessions AttendanceSession[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("teachers")
}

// Student sign-in itself is still Phase 3 scope (admin-created rosters);
// the row + enrollment relation is needed now so attendance has a roster.
model Student {
  id           String       @id @default(cuid())
  userId       String       @unique
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rollNumber   String?      @unique
  departmentId String?
  department   Department?  @relation(fields: [departmentId], references: [id])
  enrollments  Enrollment[]
  attendanceRecords AttendanceRecord[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("students")
}

model Subject {
  id           String       @id @default(cuid())
  name         String
  code         String?      @unique
  departmentId String?
  department   Department?  @relation(fields: [departmentId], references: [id])
  periods      Period[]
  enrollments  Enrollment[]

  @@map("subjects")
}

// Class roster: which students belong to which subject. Needed so
// attendance-taking knows who to list, without conflating "department"
// (many subjects) with "class" (one subject's actual roster).
model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([studentId, subjectId])
  @@map("enrollments")
}

// Replaces the old fixed lecture1..lecture8 columns: one row per timetable
// slot, so a teacher can have any number of periods across any days.
model Period {
  id        String    @id @default(cuid())
  day       DayOfWeek
  startTime String // "HH:mm", e.g. "09:00"
  endTime   String
  room      String?
  teacherId String
  teacher   Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject   @relation(fields: [subjectId], references: [id])
  attendanceSessions AttendanceSession[]
  createdAt DateTime  @default(now())

  @@index([teacherId, day])
  @@map("periods")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

// One session per period+date a teacher actually takes attendance for.
model AttendanceSession {
  id        String             @id @default(cuid())
  periodId  String
  period    Period             @relation(fields: [periodId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  date      DateTime           @db.Date
  records   AttendanceRecord[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([periodId, date])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id        String            @id @default(cuid())
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    AttendanceStatus

  @@unique([sessionId, studentId])
  @@map("attendance_records")
}

// Replaces the old embedded-subdocument TTL (which never actually worked on
// a subdocument array field). Expiry is enforced at the query layer instead.
model Notice {
  id        String    @id @default(cuid())
  title     String
  body      String
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("notices")
}
